# Copia este archivo como .env (NO lo subas al repositorio) y completa los valores.

# Perfil: dev (local, con datos de ejemplo opcionales) | prod (producción)
SPRING_PROFILES_ACTIVE=dev

# Base de datos PostgreSQL (formato JDBC)
DATABASE_URL=jdbc:postgresql://localhost:5433/salter
DATABASE_USERNAME=salter
DATABASE_PASSWORD=cambia-esta-contraseña
DATABASE_POOL_SIZE=10

# Secreto para firmar sesiones: mínimo 32 caracteres aleatorios.
# Generar con: openssl rand -base64 48
SALTER_JWT_SECRET=
# Duración de la sesión (ISO-8601). PT10H = 10 horas
SALTER_JWT_TTL=PT10H

# Orígenes permitidos del frontend, separados por coma (sin barra final)
SALTER_CORS_ORIGINS=http://localhost:3000
# En producción con HTTPS: true
SALTER_COOKIE_SECURE=false
# Lax si el frontend usa el proxy /api de Next.js (recomendado). None sólo si es otro dominio y con HTTPS.
SALTER_COOKIE_SAMESITE=Lax

# Primer administrador (sólo se usa si la base no tiene usuarios). Contraseña: 10+ caracteres con letras y números.
SALTER_BOOTSTRAP_ADMIN_EMAIL=
SALTER_BOOTSTRAP_ADMIN_PASSWORD=
SALTER_BOOTSTRAP_ADMIN_NAME=Administrador SALTER

# SOLO perfil dev: si se define, crea usuarios de ejemplo *@salter.local con esta contraseña.
SALTER_DEV_PASSWORD=

# Producción: habilitar Swagger (false por defecto en prod)
SALTER_SWAGGER_ENABLED=false
PORT=8080

# Evidencias en Cloudinary (opcional). Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
